{
    "name": "bluetree-service/symfony-console-style",
    "description": "Extends symfony console display style",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michał Adamiak",
            "email": "chajr@bluetree.pl"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.4|^8.0"
    },
    "autoload": {
        "psr-4": {
            "BlueConsole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BlueConsoleTest\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --display-warnings",
        "coverage": "./vendor/bin/phpunit --display-warnings --coverage-clover build/logs/clover.xml",
        "clover-report": "./vendor/bin/clover_reporter -c build/logs/clover.xml",
        "clover-full": "./vendor/bin/clover_reporter -f build/logs/clover.xml",
        "clover-html": "./vendor/bin/clover_reporter -P ./build/report.html -f -H build/logs/clover.xml",
        "test-complete": [
            "@coverage",
            "@clover-html"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "bluetree-service/clover-reporter": "^0.3.2"
    }
}
